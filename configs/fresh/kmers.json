{
  "seed": 73019,
  "masker": {
    "params": {
      "extra_masks": 20,
      "fractions": [
        0.05,
        0.1,
        0.15,
        0.2
      ],
      "decoy_every": 5,
      "deduplicate": false
    }
  },
  "negative_sampler": {
    "params": {
      "hard": 64,
      "random": 32
    }
  },
  "retriever": {
